# ─── Data Source API Keys ───────────────────────────────────────────────────────
# Tushare (A-share / futures / funds) — https://tushare.pro/register
TUSHARE_TOKEN=your-tushare-token

# Tiingo (US equity) — https://www.tiingo.com/about/api
TIINGO_API_KEY=your_tiingo_api_key

# Alpha Vantage (US equity) — https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Finnhub (US equity) — https://finnhub.io/
FINNHUB_API_KEY=

# Financial Modeling Prep (US equity) — https://financialmodelingprep.com/
FMP_API_KEY=

# ─── Futu OpenD Gateway ─────────────────────────────────────────────────────────
# Futu OpenD connection (HK / A-share) — requires FutuOpenD running locally
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# ─── Crypto Exchange ────────────────────────────────────────────────────────────
# CCXT exchange id (default: binance)
CCXT_EXCHANGE=binance

# ─── Data Cache ─────────────────────────────────────────────────────────────────
# Enable local Parquet cache for K-line data (1/true/yes/on to enable)
# Cache path: ~/.trading-backtest/cache/loaders/
TRADING_BACKTEST_DATA_CACHE=0

# ─── Rate Limiting (optional overrides, in seconds) ─────────────────────────────
# TRADING_BACKTEST_YAHOO_MIN_INTERVAL=0.6
# TRADING_BACKTEST_STOOQ_MIN_INTERVAL=0.6
# TRADING_BACKTEST_EASTMONEY_MIN_INTERVAL=1.0
# TRADING_BACKTEST_SINA_MIN_INTERVAL=0.5
# TRADING_BACKTEST_SEC_MIN_INTERVAL=0.12
# TRADING_BACKTEST_TIINGO_MIN_INTERVAL=0.5
# TRADING_BACKTEST_FMP_MIN_INTERVAL=0.3
# TRADING_BACKTEST_FINNHUB_MIN_INTERVAL=0.4
# TRADING_BACKTEST_ALPHAVANTAGE_MIN_INTERVAL=1.0

# ─── SEC EDGAR User-Agent (optional) ───────────────────────────────────────────
# Override the default UA string for SEC fair-access compliance
# TRADING_BACKTEST_SEC_UA=YourName/1.0 (contact: you@example.com)

# ─── Run Directory Security ─────────────────────────────────────────────────────
# Comma-separated additional allowed run roots (beyond defaults)
# TRADING_BACKTEST_ALLOWED_RUN_ROOTS=/path/to/extra/runs
