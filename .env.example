# ─── Data Source API Keys ───────────────────────────────────────────────────────
# Tushare (A-share / futures / funds) — https://tushare.pro/register
TUSHARE_TOKEN=your-tushare-token

# Tiingo (US equity) — https://www.tiingo.com/about/api
TIINGO_API_KEY=your_tiingo_api_key

# Alpha Vantage (US equity) — https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Finnhub (US equity) — https://finnhub.io/
FINNHUB_API_KEY=

# Financial Modeling Prep (US equity) — https://financialmodelingprep.com/
FMP_API_KEY=

# ─── Futu OpenD Gateway ─────────────────────────────────────────────────────────
# Futu OpenD connection (HK / A-share) — requires FutuOpenD running locally
FUTU_HOST=127.0.0.1
FUTU_PORT=11111

# ─── Crypto Exchange ────────────────────────────────────────────────────────────
# CCXT exchange id (default: binance)
CCXT_EXCHANGE=binance

# ─── Proxy (optional) ───────────────────────────────────────────────────────────
# From a mainland China network the overseas sources need a proxy while the
# domestic ones must not use one: Yahoo answers 403 when reached directly and
# OKX / Binance refuse the connection outright, whereas Eastmoney / Sina /
# Tushare work fine direct.
#   HTTP_PROXY / HTTPS_PROXY  Proxy URL, e.g. socks5h://127.0.0.1:7890
#   NO_PROXY                  Direct-connection list (parsed by requests/urllib)
#   BY_PROXY                  Proxy whitelist, parsed by backtest.loaders._http
#
# Setting BY_PROXY turns it into an explicit allowlist: buckets that match get
# the proxy, every other bucket is forced direct with trust_env=False. That is
# the point — it keeps domestic requests from exiting through an overseas proxy
# and tripping the provider's per-IP throttle.
#
# Matching takes the first label of each domain as a token and compares it with
# the loader's host_key, so list the domains behind these keys:
#   yahoo  stooq  sina  eastmoney  sec  finnhub  alphavantage  tiingo  fmp
# Note fmp's token is financialmodelingprep (see _BUCKET_ALIASES), so write
# financialmodelingprep.com rather than fmp.com.
#
# okx, yfinance and ccxt do not read BY_PROXY — they follow HTTP(S)_PROXY plus
# NO_PROXY on their own, so keep okx.com and binance.com out of NO_PROXY.
# HTTP_PROXY=socks5h://127.0.0.1:7890
# HTTPS_PROXY=socks5h://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,.eastmoney.com,.sina.com.cn,.sinajs.cn,.gtimg.cn,.tushare.pro,baostock.com
# BY_PROXY=yahoo.com,*.yahoo.com,stooq.com,*.stooq.com,finnhub.io,*.finnhub.io,alphavantage.co,*.alphavantage.co,tiingo.com,*.tiingo.com,financialmodelingprep.com,*.financialmodelingprep.com,sec.gov,*.sec.gov

# ─── Data Cache ─────────────────────────────────────────────────────────────────
# Enable local Parquet cache for K-line data (1/true/yes/on to enable)
# Cache path: ~/.trading-backtest/cache/loaders/
TRADING_BACKTEST_DATA_CACHE=0

# ─── Rate Limiting (optional overrides, in seconds) ─────────────────────────────
# TRADING_BACKTEST_YAHOO_MIN_INTERVAL=0.6
# TRADING_BACKTEST_STOOQ_MIN_INTERVAL=0.6
# TRADING_BACKTEST_EASTMONEY_MIN_INTERVAL=1.0
# TRADING_BACKTEST_SINA_MIN_INTERVAL=0.5
# TRADING_BACKTEST_SEC_MIN_INTERVAL=0.12
# TRADING_BACKTEST_TIINGO_MIN_INTERVAL=0.5
# TRADING_BACKTEST_FMP_MIN_INTERVAL=0.3
# TRADING_BACKTEST_FINNHUB_MIN_INTERVAL=0.4
# TRADING_BACKTEST_ALPHAVANTAGE_MIN_INTERVAL=1.0

# ─── SEC EDGAR User-Agent (optional) ───────────────────────────────────────────
# Override the default UA string for SEC fair-access compliance
# TRADING_BACKTEST_SEC_UA=YourName/1.0 (contact: you@example.com)

# ─── Run Directory Security ─────────────────────────────────────────────────────
# Comma-separated additional allowed run roots (beyond defaults)
# TRADING_BACKTEST_ALLOWED_RUN_ROOTS=/path/to/extra/runs
